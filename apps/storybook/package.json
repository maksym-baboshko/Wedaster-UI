{
  "name": "storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "storybook build",
    "test:storybook": "sh -c 'pnpm exec playwright install chromium >/tmp/wedaster-playwright.log 2>&1 && storybook dev --ci -p 6006 >/tmp/wedaster-storybook.log 2>&1 & pid=$!; trap \"kill $pid\" EXIT INT TERM; until curl -sf http://127.0.0.1:6006 >/dev/null; do sleep 1; done; test-storybook --url http://127.0.0.1:6006'",
    "lint": "eslint",
    "format": "prettier --write --ignore-path ../../.prettierignore \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@wedaster/ui": "workspace:*",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.3.3",
    "@storybook/addon-docs": "^10.3.3",
    "@storybook/addon-themes": "^10.3.3",
    "@storybook/react": "^10.3.3",
    "@storybook/react-vite": "^10.3.3",
    "@storybook/test-runner": "^0.24.3",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.39.2",
    "playwright": "^1.59.0",
    "storybook": "^10.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  }
}
