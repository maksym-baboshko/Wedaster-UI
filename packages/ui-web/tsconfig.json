{
  "extends": "@workspace/typescript-config/react-library.json",
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@workspace/ui-web": ["./src/index.ts"],
      "@workspace/ui-web/*": ["./src/*"]
