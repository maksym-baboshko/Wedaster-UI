{
  "extends": "@workspace/typescript-config/react-library.json",
  "compilerOptions": {
    "baseUrl": ".",
    "declaration": false,
    "declarationMap": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@wedaster/ui": ["./src/index.ts"],
      "@wedaster/ui/*": ["./src/*"]
