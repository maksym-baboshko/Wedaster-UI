{
  "name": "@wedaster/theme-default",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node ../../scripts/build-theme-css.mjs src/styles.css dist/styles.css",
    "dev": "node ../../scripts/build-theme-css.mjs src/styles.css dist/styles.css --watch",
    "typecheck": "echo \"theme-default: no TypeScript sources to check\""
  },
  "dependencies": {
    "@wedaster/tokens": "workspace:*"
  },
  "exports": {
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ]
}
